{
  "name": "task-tracker",
  "private": true,
  "scripts": {
    "dev:mongo": "docker compose up -d mongo --wait",
    "dev:apps": "pnpm --filter @task-tracker/shared build && pnpm -r --parallel --filter \"./apps/**\" dev",
    "dev": "pnpm run dev:mongo && pnpm run dev:apps",
    "build": "pnpm --filter @task-tracker/shared build && pnpm -r --filter \"./apps/**\" build",
    "lint": "pnpm --filter @task-tracker/shared build && pnpm -r --filter \"./apps/**\" lint",
    "typecheck": "pnpm --filter @task-tracker/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @task-tracker/shared build && pnpm -r --filter \"./apps/**\" test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/common": "11.2.3",
      "@nestjs/core": "11.2.3",
      "@nestjs/platform-express": "11.2.3"
    }
  }
}
